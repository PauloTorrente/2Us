# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=jdbc:postgresql://your-database-host.neon.tech/your_database?sslmode=require&channel_binding=require
DATABASE_USERNAME=your_database_user
DATABASE_PASSWORD=your_database_password

# ============================================
# JWT
# ============================================
JWT_SECRET=your_jwt_secret_key_min_64_characters_for_security_use_random_generator
JWT_EXPIRATION_MS=86400000

# ============================================
# SERVER
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ============================================
# GOOGLE PLACES API
# ============================================
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ============================================
# REDIS (Optional - Currently Disabled)
# ============================================
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
