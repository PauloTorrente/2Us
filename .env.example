# ============================================================
# CoupleApp Backend — Environment Variables
# ============================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env — it is in .gitignore
# ============================================================

# --- Database (Neon.db) ---
# Get this from your Neon dashboard > Connection Details > JDBC
# Make sure to include ?sslmode=require at the end
DATABASE_URL=jdbc:postgresql://<host>/<dbname>?sslmode=require
DATABASE_USERNAME=your_neon_user
DATABASE_PASSWORD=your_neon_password

# --- JWT ---
# Must be at least 64 characters. Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_string_minimum_64_characters_here
# Token lifetime in milliseconds. 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000

# --- Server ---
# Render injects PORT automatically. 8080 is the local default.
SERVER_PORT=8080

# --- Spring Profile ---
# "dev" = verbose SQL logs. "prod" = optimized for production.
SPRING_PROFILES_ACTIVE=dev

# --- External APIs ---
# Google Places API key (get from https://console.cloud.google.com/)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# TripAdvisor Content API key (get from https://www.tripadvisor.com/developers)
TRIPADVISOR_API_KEY=your_tripadvisor_api_key_here

# --- Redis (only required for production profile) ---
# Free options: Upstash Redis (10MB free), Redis Cloud (30MB free)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
